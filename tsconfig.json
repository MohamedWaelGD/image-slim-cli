{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitOverride": true,
    "noEmit": true,
    "lib": ["ES2022"],
    "types": ["node", "vitest/globals"],
    "skipLibCheck": true
  },
  "include": [
    "src",
    "tests",
    "benchmarks",
    "tsup.config.ts",
    "vitest.config.ts",
    "eslint.config.js"
  ]
}
